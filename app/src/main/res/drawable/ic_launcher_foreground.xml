<?xml version="1.0" encoding="utf-8"?>
<!--
    Expendora icon: a bold "E" built from three bars (like lines in a ledger) with a gold coin
    at the end of the middle bar, centred in the adaptive-icon safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- the E: stem and three bars -->
    <path
        android:pathData="M38,35 L68,35 M38,35 L38,73 M38,54 L58,54 M38,73 L68,73"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- the coin -->
    <path
        android:pathData="M70,46 A8,8 0 1,1 70,62 A8,8 0 1,1 70,46 Z"
        android:fillColor="#F2B63A" />
    <path
        android:pathData="M70,49.5 A4.5,4.5 0 1,1 70,58.5 A4.5,4.5 0 1,1 70,49.5 Z"
        android:strokeColor="#B97A06"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.7"
        android:fillColor="#00000000" />
</vector>
