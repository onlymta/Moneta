<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. Actual design-system theming (Section 9 of
         ARCHITECTURE.md) is applied in Compose via MonetaTheme; this XML
         theme only needs to exist for the manifest/window/splash. -->
    <style name="Theme.Moneta" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Shown while the app starts: brand colour with the logo, then switches to Theme.Moneta. -->
    <style name="Theme.Moneta.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Moneta</item>
    </style>
</resources>
